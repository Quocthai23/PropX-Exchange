# ========== REDIS CONFIGURATION (for Bull Queues) ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== KMS CONFIGURATION (Private Key Security) ==========
# For development (plaintext .env):
USE_AWS_KMS=false
CHAIN_ADMIN_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# For production (AWS KMS - uncomment and fill in):
# USE_AWS_KMS=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# CHAIN_ADMIN_PRIVATE_KEY_ENCRYPTED=AQIDAHg...

# ========== JWT CONFIGURATION ==========
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION=3600

# ========== BLOCKCHAIN CONFIGURATION ==========
CHAIN_RPC_URL=http://localhost:8545
CHAIN_ID=31337

# ========== APPLICATION CONFIGURATION ==========
NODE_ENV=development
PORT=3002
ENABLE_MARKET_MAKER=true
ENABLE_DEMO_MARKET_DATA=true

# ========== SMTP CONFIGURATION (Email Testing) ==========
