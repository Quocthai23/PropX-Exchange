# or Mailtrap (https://mailtrap.io/)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nq9608066@gmail.com
SMTP_PASS=xxgyuwptledkbewo
DATABASE_POOL_MAX=10
PRISMA_CONNECT_RETRIES=5

DB_ADMIN_USER=root
