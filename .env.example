# Database
DATABASE_URL=mysql://user:password@localhost:3306/rwa_db

# Prisma connection pool and retry
DATABASE_POOL_MAX=10
PRISMA_CONNECT_RETRIES=5

# Admin credentials and target for applying max_connections (use only in dev/ops)
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306
DB_MAX_CONNECTIONS=200
